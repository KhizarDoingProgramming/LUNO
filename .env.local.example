# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/luno?sslmode=require

# NextAuth.js
NEXTAUTH_SECRET=your_secret_here_generate_with_openssl_rand_base64_32
