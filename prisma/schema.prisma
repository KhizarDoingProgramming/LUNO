generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// NEXTAUTH TABLES
// ============================================

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?

  profile       Profile?
  accounts      Account[]
  sessions      Session[]
  progress      UserProgress[]
  vocabulary    UserVocabulary[]
  answers       UserAnswer[]
  dailyGoals    DailyGoal[]
  achievements  UserAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// USER PROFILE
// ============================================

model Profile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  nativeLanguageId   String
  targetLanguageId   String
  level              String   @default("beginner")
  dailyGoalMinutes   Int      @default(10)
  totalXp            Int      @default(0)
  currentStreak      Int      @default(0)
  longestStreak      Int      @default(0)
  lastActivityDate   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// LANGUAGE DATA
// ============================================

model Language {
  id         String @id @default(uuid())
  code       String @unique
  name       String
  nativeName String
  flagEmoji  String
  isActive   Boolean @default(true)

  courses      Course[]
  vocabulary   Vocabulary[]
  sentences    Sentence[]
  grammarRules GrammarRule[]

  createdAt DateTime @default(now())
}

model Course {
  id          String @id @default(uuid())
  languageId  String
  level       String
  title       String
  description String?
  orderIndex  Int

  language Language @relation(fields: [languageId], references: [id])
  units    Unit[]

  createdAt DateTime @default(now())

  @@unique([languageId, level])
}

model Unit {
  id          String @id @default(uuid())
  courseId     String
  title       String
  description String?
  orderIndex  Int
  isLocked    Boolean @default(true)

  course  Course   @relation(fields: [courseId], references: [id])
  lessons Lesson[]
  grammarRules GrammarRule[]

  createdAt DateTime @default(now())
}

model Lesson {
  id          String @id @default(uuid())
  unitId      String
  title       String
  description String?
  orderIndex  Int
  xpReward    Int    @default(50)
  isLocked    Boolean @default(true)

  unit      Unit           @relation(fields: [unitId], references: [id])
  exercises Exercise[]
  progress  UserProgress[]

  createdAt DateTime @default(now())
}

// ============================================
// VOCABULARY & SENTENCES
// ============================================

model Vocabulary {
  id                String @id @default(uuid())
  languageId        String
  word              String
  translation       String
  partOfSpeech      String
  gender            String?
  article           String?
  audioUrl          String?
  exampleSentence   String?
  exampleTranslation String?
  difficulty        Int    @default(1)

  language     Language          @relation(fields: [languageId], references: [id])
  forms        VocabularyForm[]
  userVocab    UserVocabulary[]

  createdAt DateTime @default(now())
}

model VocabularyForm {
  id            String @id @default(uuid())
  vocabularyId  String
  formType      String
  formValue     String
  gender        String?
  number        String?
  case          String?

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id])

  createdAt DateTime @default(now())
}

model Sentence {
  id           String @id @default(uuid())
  languageId   String
  text         String
  translation  String
  audioUrl     String?
  difficulty   Int    @default(1)

  language Language @relation(fields: [languageId], references: [id])

  createdAt DateTime @default(now())
}

model GrammarRule {
  id          String @id @default(uuid())
  languageId  String
  title       String
  explanation String
  examples    String @default("[]")

  language Language @relation(fields: [languageId], references: [id])
  unit     Unit?    @relation(fields: [unitId], references: [id])
  unitId   String?

  createdAt DateTime @default(now())
}

// ============================================
// EXERCISES
// ============================================

model Exercise {
  id            String @id @default(uuid())
  lessonId      String
  type          String
  question      String
  correctAnswer String
  explanation   String?
  orderIndex    Int
  xpValue       Int    @default(10)
  metadata      String @default("{}")

  lesson    Lesson           @relation(fields: [lessonId], references: [id])
  options   ExerciseOption[]
  answers   UserAnswer[]

  createdAt DateTime @default(now())
}

model ExerciseOption {
  id         String @id @default(uuid())
  exerciseId String
  text       String
  isCorrect  Boolean
  orderIndex Int

  exercise Exercise @relation(fields: [exerciseId], references: [id])

  createdAt DateTime @default(now())
}

// ============================================
// PROGRESS & TRACKING
// ============================================

model UserProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  score       Int       @default(0)
  bestScore   Int       @default(0)
  attempts    Int       @default(0)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model UserVocabulary {
  id            String    @id @default(uuid())
  userId        String
  vocabularyId  String
  mastery       Int       @default(0)
  correctCount  Int       @default(0)
  incorrectCount Int      @default(0)
  lastReviewed  DateTime?
  nextReview    DateTime?

  user      User      @relation(fields: [userId], references: [id])
  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, vocabularyId])
}

model UserAnswer {
  id         String   @id @default(uuid())
  userId     String
  exerciseId String
  answer     String
  isCorrect  Boolean
  answeredAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  exercise Exercise @relation(fields: [exerciseId], references: [id])
}

// ============================================
// GAMIFICATION
// ============================================

model DailyGoal {
  id            String  @id @default(uuid())
  userId        String
  date          DateTime
  targetMinutes Int
  actualMinutes Int     @default(0)
  xpEarned      Int     @default(0)
  completed     Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model Achievement {
  id               String @id @default(uuid())
  name             String @unique
  description      String
  icon             String
  requirementType  String
  requirementValue Int
  xpReward         Int    @default(0)

  users UserAchievement[]

  createdAt DateTime @default(now())
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}
